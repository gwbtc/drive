<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The activity draws everything with Compose; the platform theme only
         has to stay out of the way (no action bar, transparent system bars
         under edge-to-edge). -->
    <style name="Theme.Drive" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
