{
  // Editor-only config for the Playwright specs. Deliberately NOT referenced
  // by client/tsconfig.json (which includes only src/ and e2e/) — these files
  // run under Playwright's own transpiler, not the app typecheck.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["./**/*.ts"]
}
