{
  "name": "groundwire-drive-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "build:js": "bun build src/index.tsx --outfile=../desk/app/documents/js.js --minify --target=browser --format=iife",
    "build:css": "bun build src/styles/app.css --outfile=../desk/app/documents/css.css",
    "build:sw": "bun build src/sw.ts --outfile=../desk/app/documents/sw.js --target=browser --format=iife",
    "build": "bun run typecheck && bun run build:js && bun run build:css && bun run build:sw",
    "watch": "bun build src/index.tsx --outfile=../desk/app/documents/js.js --target=browser --format=iife --watch"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "@tiptap/core": "^2.10.0",
    "@tiptap/extension-character-count": "^2.10.0",
    "@tiptap/extension-collaboration": "^2.10.0",
    "@tiptap/extension-collaboration-cursor": "^2.10.0",
    "@tiptap/extension-color": "^2.10.0",
    "@tiptap/extension-font-family": "^2.10.0",
    "@tiptap/extension-highlight": "^2.10.0",
    "@tiptap/extension-image": "^2.10.0",
    "@tiptap/extension-link": "^2.10.0",
    "@tiptap/extension-placeholder": "^2.10.0",
    "@tiptap/extension-subscript": "^2.10.0",
    "@tiptap/extension-superscript": "^2.10.0",
    "@tiptap/extension-table": "^2.10.0",
    "@tiptap/extension-table-cell": "^2.10.0",
    "@tiptap/extension-table-header": "^2.10.0",
    "@tiptap/extension-table-row": "^2.10.0",
    "@tiptap/extension-task-item": "^2.10.0",
    "@tiptap/extension-task-list": "^2.10.0",
    "@tiptap/extension-text-align": "^2.10.0",
    "@tiptap/extension-text-style": "^2.10.0",
    "@tiptap/extension-typography": "^2.10.0",
    "@tiptap/extension-underline": "^2.10.0",
    "@tiptap/starter-kit": "^2.10.0",
    "preact": "^10.24.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
